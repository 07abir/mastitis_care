# Copy this file to .env and fill it in.  cp .env.example .env
#
# .env holds a private key. Never commit it, never paste it into a slide, and
# never use a key that has ever touched mainnet funds. Generate a throwaway
# wallet for this project and fund it from the Amoy faucet only.

# ---------------------------------------------------------------- chain mode
# auto : try the real chain, fall back to the local simulation and say why
# real : require Polygon Amoy; fail loudly if anything is missing
# mock : never touch the network (use this on conference wifi)
CHAIN_MODE=auto

# ------------------------------------------------------------------ network
# Polygon Amoy testnet. The public endpoint is rate-limited; for a live demo
# get a free dedicated URL from Alchemy, Infura or Ankr and paste it here.
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/

# ------------------------------------------------------------------- wallet
# The oracle account that signs storeHealthRecord calls. 64 hex characters,
# with or without the 0x prefix. Fund it with free test POL:
#   https://faucet.polygon.technology  (select Amoy)
ORACLE_PRIVATE_KEY=

# ------------------------------------------------------------------ contract
# Filled in for you by:  python scripts/deploy_contract.py
CONTRACT_ADDRESS=

# -------------------------------------------------------------------- limits
# Cows per run when writing on-chain. Each transaction costs gas and takes a
# few seconds to confirm, so keep this small in real mode and use --batch to
# put many cows in a single transaction.
ONCHAIN_BATCH_SIZE=10

# --------------------------------------------------------------------- server
API_HOST=127.0.0.1
API_PORT=8000

# --------------------------------------------------------------------- extras
# Set to 1 to keep the 'Day' column as a feature. It is dropped by default
# because it carries no signal (see the note in src/config.py).
KEEP_DAY=0
